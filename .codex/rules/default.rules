# Repository safety policy for commands that request execution outside the sandbox.

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Preserve uncommitted work; use a non-destructive recovery path.",
)

prefix_rule(
    pattern = ["git", "clean", ["-f", "-fd", "-df", "--force"]],
    decision = "forbidden",
    justification = "Do not delete untracked work; inspect targets and remove them explicitly.",
)

prefix_rule(
    pattern = ["git", "push", ["--force", "-f"]],
    decision = "forbidden",
    justification = "Do not rewrite remote history; use a normal push.",
)

prefix_rule(
    pattern = ["git", "-C"],
    decision = "forbidden",
    justification = "Run Git from the explicit repository working directory.",
)

prefix_rule(
    pattern = ["git", "checkout", "."],
    decision = "forbidden",
    justification = "Do not discard the working tree; restore only explicit, verified files.",
)

prefix_rule(
    pattern = ["rm", ["-rf", "-fr"]],
    decision = "forbidden",
    justification = "Use a recoverable or explicitly scoped removal method.",
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Repository tasks must not require privilege escalation through sudo.",
)
